# Copy this file to backend/.env and fill in YOUR OWN values.
# Never commit the real .env file or share these values with anyone
# (including in chat) — fill them in directly on your machine.

# --- MT5 demo account ---
MT5_LOGIN=00000000
MT5_PASSWORD=your-demo-account-password
MT5_SERVER=YourBroker-Demo
MT5_TERMINAL_PATH=C:\Program Files\YourBroker MT5 Terminal\terminal64.exe

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Set this to the path of a service account JSON key, OR skip it and
# run `gcloud auth application-default login` instead:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# --- Risk defaults ---
DEFAULT_DAILY_LOSS_CAP_PCT=2.0
DEFAULT_RISK_PER_TRADE_PCT=0.5

# --- Shared secret Gemini Enterprise's tool config must send back as
#     a header (X-Backend-Api-Key) on every call to this API ---
BACKEND_API_KEY=generate-a-random-string-here
# A second, separate random string — used to sign risk-approval tokens
RISK_TOKEN_SECRET=generate-a-different-random-string-here

# --- Optional: comma separated emails/webhooks for the daily report ---
REPORT_RECIPIENTS=
